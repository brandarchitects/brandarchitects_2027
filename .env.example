# Kopie als .env.local anlegen (wird nicht committet). In Vercel: Settings → Environment Variables.
# Einfachster Weg: `npx vercel link` und `npx vercel env pull .env.local` – holt alle Werte aus Vercel.

# Sanity – werden von der Vercel-Sanity-Integration automatisch gesetzt
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-15
# Editor-Token für scripts/seed.ts – von der Vercel-Integration gesetzt. NIE im Browser, NIE committen.
SANITY_API_WRITE_TOKEN=
# Alternative, wenn manuell in Sanity Manage → API → Tokens (Rolle Editor) erstellt:
SANITY_WRITE_TOKEN=
# Webhook-Secret für /api/revalidate (frei wählbarer langer String, in Sanity identisch eintragen)
SANITY_REVALIDATE_SECRET=

# Kontaktformular (Phase 2, Resend direkt auf resend.com einrichten – ADR-011)
RESEND_API_KEY=
CONTACT_TO=anfragen@brandarchitects.ch
CONTACT_FROM="Brand Architects Website <website@brandarchitects.ch>"

# Öffentliche Basis-URL (Canonical, Sitemap, Schema.org)
NEXT_PUBLIC_SITE_URL=https://brandarchitects.ch
